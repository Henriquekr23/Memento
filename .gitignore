# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.p12
*.local
# arquivos-fantasma que sobram quando a pasta é montada por outro processo
.fuse_hidden*

# editores
.idea/
*.swp

# material de teste local (fotos de verdade nunca devem ir para o repositório)
/local/
/fotos-teste/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Nunca versionar. E lembrar, na Fase 2: tudo que começa com NEXT_PUBLIC_ é
# embutido no bundle e fica visível para qualquer visitante — segredo (como a
# service_role key do Supabase) jamais pode usar esse prefixo.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
